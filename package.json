    "dev:local": "npm run dev:local -w apps/api"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "scheduler": "0.23.2",
    "react-dom": {
      "scheduler": "0.23.2"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4"
  }
}
