{
  "name": "@drug-medicine-lookup/api",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node --esm src/index.ts",
    "dev:local": "ts-node src/devServer.ts",
    "migrate": "ts-node src/db/migrate.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@drug-medicine-lookup/shared": "*",
    "@types/cors": "2.8.19",
    "cors": "2.8.6",
    "express": "4.18.2",
    "pg": "8.11.3"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.11.5",
    "@types/pg": "8.11.0",
    "@types/supertest": "6.0.2",
    "fast-check": "3.15.0",
    "pg-mem": "2.8.1",
    "supertest": "6.3.4",
    "ts-node": "10.9.2",
    "typescript": "5.3.3",
    "vitest": "1.2.2"
  }
}
